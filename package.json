{
  "name": "slack-cleaner",
  "version": "1.0.0",
  "description": "Chrome extension to select and delete your own Slack messages",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "package": "npm run build && node scripts/package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/treposting/slack-bot.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/treposting/slack-bot/issues"
  },
  "homepage": "https://github.com/treposting/slack-bot#readme",
  "engines": {
    "node": ">=22.18"
  },
  "private": true,
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
