# Copy to .env (never commit it) and run `npm run start:env`.

# Option 1: paste your User OAuth Token here to skip the sign-in screen.
# SLACK_USER_TOKEN=xoxp-...

# Option 2: "Sign in with Slack" button. Needs the app's credentials and a
# redirect URL of <BASE_URL>/auth/slack/callback added in the Slack app settings.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# BASE_URL=http://localhost:3000

# Set to 1 to try the UI without deleting anything.
# DRY_RUN=1

# PORT=3000
# HOST=127.0.0.1
